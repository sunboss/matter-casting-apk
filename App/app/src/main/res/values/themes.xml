<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Matter Casting dark theme with cyan accent -->
    <style name="Theme.CHIPTVCastingApp" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cyan_accent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/cyan_accent_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/cyan_accent_light</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
